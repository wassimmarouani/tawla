# Copy to .env.local and fill in. Every variable is documented in docs/setup.md
# and validated at boot by src/lib/env.ts. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tawla
APP_DOMAIN=localhost:3000

# Database (local Supabase; hosted envs use the transaction pooler URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (local defaults printed by `pnpm db:status`; the local publishable key is the
# CLI's fixed development key, not a secret)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
