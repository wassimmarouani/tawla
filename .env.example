# Copy to .env.local and fill in. Every variable is documented in docs/setup.md
# and validated at boot by src/lib/env.ts. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tawla
APP_DOMAIN=localhost:3000

# Database (local Supabase; hosted envs use the transaction pooler URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (local defaults printed by `pnpm db:status`; the local publishable key is the
# CLI's fixed development key, not a secret)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Privileged key, read only by src/server/admin (media pipeline). Local value is the CLI's
# fixed development key; hosted envs use the project's secret key from the dashboard.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Customer session cookie (ADR-0011). Any 32+ character string locally; a random secret in
# hosted environments (openssl rand -base64 32).
CLIENT_SESSION_SECRET=local-development-client-session-secret-0123456789

# Rate limiting (ADR-0011): leave empty locally to use the in-memory adapter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile, shown only when the anomaly heuristic fires (ADR-0011). Leave empty
# locally: the app falls back to Cloudflare's public test keys (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push for staff devices (ADR-0022): `pnpm dlx web-push generate-vapid-keys`. Leave empty
# to disable push locally. VAPID_SUBJECT is mailto: or https: contact of the operator.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Scheduled jobs (ADR-0009): bearer secret of /api/cron/*, also stored in Supabase Vault as
# `cron_secret`. Any 32+ character string locally (openssl rand -base64 32 in hosted envs).
CRON_SECRET=

# AI menu import and translation (ADR-0030). Your own Gemini key with a low spend limit;
# tests never call the API (recorded responses). Models default to gemini-2.5-flash.
GEMINI_API_KEY=
AI_MODEL_EXTRACT=
AI_MODEL_TRANSLATE=

# Marketing pages (P1-16): demo venue slug (iframe + QR) and sales WhatsApp (digits, 216…).
DEMO_MENU_SLUG=cafe-el-bahja
CONTACT_WHATSAPP=
