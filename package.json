{
  "name": "tawla",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project node --project dom",
    "test:watch": "vitest --project node --project dom",
    "test:coverage": "vitest run --project node --project dom --coverage",
    "test:e2e": "playwright test",
    "check:versions": "node scripts/check-versions.mjs",
    "prepare": "husky",
    "db:start": "supabase start -x vector,logflare",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm db:seed-media && tsx scripts/print-demo.ts",
    "db:new": "supabase migration new",
    "db:status": "supabase status",
    "test:db": "supabase test db",
    "check:rls": "tsx scripts/check-rls-coverage.ts",
    "test:integration": "vitest run --project integration",
    "db:pull": "drizzle-kit pull && tsx scripts/clean-drizzle-pull.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "demo:info": "tsx scripts/print-demo.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "db:seed-media": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed-media.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@leeoniya/ufuzzy": "1.0.19",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "culori": "4.0.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "thumbhash": "0.1.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "lint-staged": "17.6.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
